{
  "name": "grpc-libp2p-client",
  "version": "0.0.30",
  "type": "module",
  "description": "grpc-libp2p-client",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./dc-http2/stream": {
      "import": "./dist/dc-http2/stream.esm.js",
      "require": "./dist/dc-http2/stream.cjs.js",
      "types": "./dist/dc-http2/stream.d.ts"
    },
    "./dc-http2/frame": {
      "import": "./dist/dc-http2/frame.esm.js",
      "require": "./dist/dc-http2/frame.cjs.js",
      "types": "./dist/dc-http2/frame.d.ts"
    },
    "./dc-http2/parser": {
      "import": "./dist/dc-http2/parser.esm.js",
      "require": "./dist/dc-http2/parser.cjs.js",
      "types": "./dist/dc-http2/parser.d.ts"
    },
    "./dc-http2/hpack": {
      "import": "./dist/dc-http2/hpack.esm.js",
      "require": "./dist/dc-http2/hpack.cjs.js",
      "types": "./dist/dc-http2/hpack.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcnetio/grpc-libp2p-client.git"
  },
  "homepage": "https://github.com/dcnetio/grpc-libp2p-client#readme",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src/",
    "build:w": "rollup -c -w",
    "build": "rollup -c",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon --watch ./ --ext ts,tsx,js,jsx,json --ignore 'src/**/*.test.ts' --exec 'npx yalc push'"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@libp2p/interface": "^2.9.0",
    "@multiformats/multiaddr": "^12.4.0",
    "it-pipe": "^3.0.1",
    "it-pushable": "^3.2.3",
    "libp2p": "^2.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@eslint/js": "^9.29.0",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "eslint": "^9.29.0",
    "nodemon": "^3.1.9",
    "rollup-plugin-dts": "^6.2.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  } ,
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.54.0"
  }
}